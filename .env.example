# Copie este arquivo para ".env" e ajuste os valores:  cp .env.example .env
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Banco interno do Airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_SECRET_KEY=troque-por-um-texto-aleatorio-longo

# Usuário da interface do Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Data warehouse (PostgreSQL com os dados da ANP)
WAREHOUSE_DB=anp
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_PORT_HOST=5433
